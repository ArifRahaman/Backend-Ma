# Copy to .env for local dev. On Render, set these in the dashboard (Environment).
AZURE_OPENAI_ENDPOINT="https://openaidev-westus.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_CHATGPT_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"
AZURE_OPENAI_RESOURCE_NAME="openaidev-westus"

# --- Azure auth (service principal) ---
AZURE_TENANT_ID="your-tenant-id"
AZURE_CLIENT_ID="your-client-id"
AZURE_CLIENT_SECRET="your-client-secret"

# --- Sarvam AI text-to-speech (built for Indian languages) ---
SARVAM_API_KEY="your-sarvam-api-key"
# Optional — see https://docs.sarvam.ai/api/api-guides-tutorials/text-to-speech/voices
# SARVAM_SPEAKER="shubh"
# SARVAM_MODEL="bulbul:v3"
# Arif's replies are Hinglish in Latin script, so "en-IN" (Indian-accented
# English) reads them more naturally than "hi-IN" (expects Devanagari script).
# SARVAM_LANGUAGE_CODE="en-IN"

# Note: Arif's summarize_link tool (YouTube video + webpage summaries) needs
# no API key at all — nothing to configure for it.

# --- YouTube Data API v3 (powers Arif's find_song tool) ---
# Free from Google Cloud Console: create a project, enable "YouTube Data
# API v3", then create an API key.
YOUTUBE_API_KEY="your-youtube-data-api-key"

# Render provides PORT automatically; only needed locally.
PORT=4001

# Production only: lock CORS to your frontend origin(s), comma-separated.
# CORS_ORIGIN="https://your-app.vercel.app"
