# Copy to .env for local dev. On Render, set these in the dashboard (Environment).
AZURE_OPENAI_ENDPOINT="https://openaidev-westus.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_CHATGPT_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"
AZURE_OPENAI_RESOURCE_NAME="openaidev-westus"

# --- Azure auth (service principal) ---
AZURE_TENANT_ID="your-tenant-id"
AZURE_CLIENT_ID="your-client-id"
AZURE_CLIENT_SECRET="your-client-secret"

# Render provides PORT automatically; only needed locally.
PORT=4001

# Production only: lock CORS to your frontend origin(s), comma-separated.
# CORS_ORIGIN="https://your-app.vercel.app"
